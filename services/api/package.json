{
  "name": "@resource-gallery/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "dev": "node --env-file=../../.env --watch --import tsx src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "seed": "node --env-file=../../.env --import tsx src/seed-cli.ts",
    "sync:seed-credentials": "node --env-file=../../.env --import tsx src/sync-seed-credentials.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --import tsx --test src/smoke.test.ts src/summary.test.ts src/tags.test.ts src/stream-upload.test.ts src/db-migration.test.ts src/sync.test.ts src/http-range.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/lib-storage": "^3.817.0",
    "@hono/node-server": "^1.13.7",
    "@resource-gallery/export-schema": "workspace:*",
    "busboy": "^1.6.0",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
