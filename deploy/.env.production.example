# Public canonical URL. It must use HTTPS in production because sessions are Secure cookies.
PUBLIC_ORIGIN=https://gallery.example.com

# Caddy obtains and renews the TLS certificate for this hostname. DNS must point here first.
SITE_ADDRESS=gallery.example.com

# Generate independently, for example: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-session-secret
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-download-signing-secret

# Production media blobs. Keep filesystem only for a single-node development deployment.
BLOB_STORAGE_BACKEND=s3
BLOB_S3_BUCKET=resource-gallery-production
BLOB_S3_REGION=us-east-1
BLOB_S3_ENDPOINT=
BLOB_S3_PREFIX=resource-gallery
BLOB_S3_FORCE_PATH_STYLE=false
# Leave blank when workload identity/instance roles provide credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Used only by the one-time bootstrap command in docs/deployment.md.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Maximum accepted compressed and uncompressed package size in bytes (512 MiB by default).
MAX_PACKAGE_BYTES=536870912
MAX_UNCOMPRESSED_PACKAGE_BYTES=805306368
MAX_AUDIO_OVERVIEW_BYTES=67108864
MAX_VIDEO_OVERVIEW_BYTES=134217728
MAX_PREVIEW_BYTES=10485760

# Video2PPT machine sync is disabled until the canary is approved.
RESOURCE_GALLERY_SYNC_ENABLED=false
RESOURCE_GALLERY_SYNC_TOKEN=
RESOURCE_GALLERY_SYNC_ACTOR_EMAIL=admin@example.com
RESOURCE_GALLERY_SYNC_MAX_REMOVED_FILES=0
RESOURCE_GALLERY_SYNC_MAX_ATTEMPTS=3

# Optional OpenAI-compatible summary generation.
SUMMARY_LLM_BASE_URL=https://api.openai.com/v1
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_MODEL=gpt-4.1-mini
SUMMARY_LLM_TIMEOUT_MS=20000
