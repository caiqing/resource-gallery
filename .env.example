# API
NODE_ENV=development
PORT=8787
DATABASE_PATH=./data/gallery.db
BLOB_ROOT=./data/blobs
# `filesystem` for local development; `s3` enables an S3-compatible production backend.
BLOB_STORAGE_BACKEND=filesystem
BLOB_S3_BUCKET=
BLOB_S3_REGION=us-east-1
BLOB_S3_ENDPOINT=
BLOB_S3_PREFIX=resource-gallery
BLOB_S3_FORCE_PATH_STYLE=false
UPLOAD_ROOT=./data/uploads
# Generate each value independently with: openssl rand -hex 32
SESSION_SECRET=
DOWNLOAD_SIGNING_SECRET=
SEED_USERS=true
SEED_TEST_USER=true
MAX_PACKAGE_BYTES=536870912
MAX_UNCOMPRESSED_PACKAGE_BYTES=805306368
MAX_AUDIO_OVERVIEW_BYTES=67108864
MAX_VIDEO_OVERVIEW_BYTES=134217728
MAX_PREVIEW_BYTES=10485760
# Machine sync is disabled by default. Enable only with a separately managed token.
RESOURCE_GALLERY_SYNC_ENABLED=false
RESOURCE_GALLERY_SYNC_TOKEN=
RESOURCE_GALLERY_SYNC_ACTOR_EMAIL=
RESOURCE_GALLERY_SYNC_MAX_REMOVED_FILES=0
RESOURCE_GALLERY_SYNC_MAX_ATTEMPTS=3
CORS_ORIGIN=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173

# Optional OpenAI-compatible summary generation. Leave blank for local text fallback.
SUMMARY_LLM_ENABLED=1
SUMMARY_LLM_PROVIDER=openai-compatible
SUMMARY_LLM_BASE_URL=https://api.openai.com/v1
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_MODEL=gpt-4.1-mini
SUMMARY_LLM_FALLBACK_MODELS=
SUMMARY_LLM_TIMEOUT_MS=20000
SUMMARY_LLM_TEMPERATURE=0.2
SUMMARY_LLM_MAX_TOKENS=240

# Seed admin (dev only)
SEED_ADMIN_EMAIL=admin@gallery.local
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@gallery.local
SEED_USER_PASSWORD=
