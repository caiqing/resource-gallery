{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resource-gallery.local/schemas/resource-gallery.export.v1.json",
  "title": "resource-gallery.export/v1 manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "exported_at",
    "task_id",
    "run_id",
    "run_index",
    "title",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "resource-gallery.export/v1"
    },
    "exported_at": {
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "product": { "type": "string" },
        "product_version": { "type": "string" }
      }
    },
    "task_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "run_index": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path", "name", "kind", "sha256", "size_bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "slide_pdf",
              "slide_deck",
              "infographic",
              "content",
              "blueprint",
              "prompt",
              "source_context",
              "video",
              "subtitle",
              "auth",
              "other"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "default_include": { "type": "boolean" },
          "source_run_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "excluded_by_default_kinds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "export_scope": {
      "enum": ["run", "task"]
    },
    "source_run_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
